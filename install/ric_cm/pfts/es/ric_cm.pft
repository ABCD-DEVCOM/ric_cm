							if nocc(v122)=1 then 
								if v122^u='Oui' then 
									'<a href="',v122^i, '" target=New>', v122^i, '</a>', 
								else, v122^i, 
								fi 
								' (<small>', v122^e,', ', v122^s, ', ', v122^c, ')' 
							else if nocc(v122) <> 0 then
								( '<ul><li>' 
									if v122^u='Oui' then 
										'<a href=" <small>',v122^i, '</small>" target=New> Accéder en ligne</a>', 
									else '<small>' v122^i, fi, '</small> 
										(', v122^e,', ', v122^s, ', ', v122^c, ')</li>' /	) 
							fi fi  
							'</ul>
						</td>
                    </tr>'
				fi 
            if p(v128) then 
