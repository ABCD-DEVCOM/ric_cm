'
<style>
@import url("https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap");
@import url("https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css");
    :root {
        --ric-navy-dark: #0f172a;        /* Bleu nuit très foncé */
        --ric-navy-main: #1e293b;        /* Bleu marine principal (unifié pour tous les en-têtes) */
        --ric-navy-light: #f8fafc;      /* Fond léger */
        --ric-border: #cbd5e1;          /* Ligne / Bordure */
        
        --ric-yellow-accent: #f59e0b;   /* Jaune ambré / Doré principal */
        --ric-yellow-light: #fef3c7;    /* Jaune très clair pour les badges */
        --ric-yellow-text: #92400e;     /* Texte foncé sur fond jaune */
        --ric-yellow-gold: #fbbf24;     /* Jaune vif pour les icônes */
        
        --texte: #334155;
        --texte-doux: #64748b;
        --surface: #ffffff;
    }

    .ric-wrap {
        font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif;
        max-width: 1600px;
        margin: 15px auto;
        background: var(--surface);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08);
        border: 1px solid var(--ric-border);
        color: var(--texte);
    }

    /* En-tête Principal Unifié (Bleu Marine & Jaune Doré) */
    .ric-entete {
        background: linear-gradient(135deg, var(--ric-navy-dark) 0%, var(--ric-navy-main) 100%);
        color: #ffffff;
        padding: 14px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 3px solid var(--ric-yellow-accent);
    }

    .ric-entete-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .ric-entete-brand i {
        color: var(--ric-yellow-gold);
        font-size: 22px;
    }

    .ric-entete-titre {
        font-size: 18px;
        font-weight: 800;
        color: #ffffff;
    }

    .ric-entete-sous {
        font-size: 11.5px;
        color: var(--ric-yellow-gold);
        font-weight: 500;
        opacity: 0.9;
    }

    /* Grille Paysage 2 Colonnes */
    .ric-grid-landscape {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        width: 100%;
        border-bottom: 1px solid var(--ric-border);
    }

    .ric-col-left {
        border-right: 1px solid var(--ric-border);
        background: var(--surface);
        padding: 0;
    }

    .ric-col-right {
        background: #fafafa;
        padding: 0;
    }

    .ric-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .ric-table td {
        padding: 8px 14px;
        border-bottom: 1px solid var(--ric-border);
        vertical-align: top;
    }

    .ric-table tr:hover td:not(.ric-section) {
        background: var(--ric-navy-light);
    }

    /* Encadrement pour textes longs */
    .ric-scrollable-content {
        max-height: 250px;
        overflow-y: auto;
        padding-right: 6px;
        line-height: 1.5;
    }

    .ric-scrollable-content::-webkit-scrollbar {
        width: 4px;
    }

    .ric-scrollable-content::-webkit-scrollbar-thumb {
        background: var(--ric-border);
        border-radius: 4px;
    }

    /* Bandeaux de Section UNIFORMISÉS EN BLEU MARINE */
    .ric-section {
        background-color: var(--ric-navy-main) !important;
        color: #ffffff !important;
        padding: 9px 16px !important;
        font-weight: 600 !important;
        font-size: 11px !important;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        border-bottom: 2px solid var(--ric-yellow-accent) !important;
    }

    .ric-section i {
        color: var(--ric-yellow-gold);
        margin-right: 6px;
    }

    /* Zone Horizontale Basse : Fichiers & Logs */
    .ric-bottom-panel {
        background: var(--ric-navy-light);
    }

    .ric-file-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 10px 16px;
    }

    .ric-file-card {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        border: 1px solid var(--ric-border);
        padding: 6px 14px;
        border-radius: 6px;
        color: #0284c7;
        font-weight: 600;
        text-decoration: none;
        font-size: 12.5px;
    }

    .ric-file-card i {
        color: var(--ric-yellow-accent);
    }

    .ric-file-card:hover {
        border-color: var(--ric-yellow-accent);
        background: var(--ric-yellow-light);
        color: var(--ric-yellow-text);
    }

    /* Traçabilité Horizon */
    .ric-log-row {
        padding: 10px 16px;
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .ric-log-label {
        font-weight: 700;
        color: var(--ric-navy-dark);
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .ric-log-label i {
        color: var(--ric-yellow-accent);
    }

    .ric-log-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--ric-yellow-light);
        color: var(--ric-yellow-text);
        border: 1px solid #fde68a;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 11.5px;
        font-weight: 700;
    }

    .ric-log-date {
        color: var(--texte-doux);
        font-size: 12px;
    }

    .ric-signature-block {
        text-align: right;
        font-size: 0.72rem;
        color: var(--ric-navy-main);
        padding: 6px 16px;
        background: var(--surface);
        border-top: 1px solid var(--ric-border);
    }

    .ric-signature-block strong {
        color: var(--ric-yellow-text);
        background-color: var(--ric-yellow-light);
        padding: 2px 6px;
        border-radius: 3px;
        border: 1px solid #fde68a;
    }
    </style>
</head>
<body>

    <div class="ric-wrap">
        <!-- 1. EN-TÊTE PRINCIPAL (.ric-entete, .ric-entete-brand, .ric-entete-titre, .ric-entete-sous) -->
        <div class="ric-entete">
            <div class="ric-entete-brand">
                <i class="fa-solid fa-shield-halved"></i>
                <div>
                    <div class="ric-entete-titre">Notice descriptive</div>
                    <div class="ric-entete-sous">Records in Contexts - Conceptual Model</div>
                </div>
            </div>
            <div>
                <span class="ric-log-badge"><i class="fa-solid fa-circle-check"></i>'
		if p(v128[1]^f) then 
			v128[1]^f, ' ', v128[1]^l 
			if npost('RI070_',v2) > 0 and npost('RI072_',v2) > 0 then 
				' (', ref(l('RI070_',v2), v129*6.4), ' -  ', ref(l('RI072_',v2), v129*6.4) ') ',
			else
				if npost('RI070_',v2) > 0 then 
					' (', ref(l('RI070_',v2), v129*6.4), ' - )' 
				fi 
			fi  
		else 
			if p(v128[1]^o) then 
				v128[1]^o
				if npost('RI069_',v2) > 0 and npost('RI071_',v2) > 0 then 
					' (', ref(l('RI069_',v2), v129*6.4), ' -  ', ref(l('RI071_',v2), v129*6.4) ') ',
				else
					if npost('RI069_',v2) > 0 then 
						' (', ref(l('RI071_',v2), v129*6.4), ' - )' 
					fi 
				fi  
			fi 
		fi

				'</span>
            </div>
        </div>

        <!-- 2. GRILLE PAYSAGE 2 COLONNES (.ric-grid-landscape, .ric-col-left, .ric-col-right) -->
        <div class="ric-grid-landscape">
            
            <!-- Colonne Gauche -->
            <div class="ric-col-left">
                <table class="ric-table">
                    <!-- Bandeau de Section (.ric-section) -->
                    <tr>
                        <td colspan="2" class="ric-section">
                            <i class="fa-solid fa-circle-info"></i> General informations
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 35%; font-weight: 600;">Entity type</td>
                        <td>', 
								select s(v1*0.7) 
									case 'RiC-E03':	ref(['ric_msg']3, v1)
									case 'RiC-E04': ref(['ric_msg']4, v1)
									case 'RiC-E05': ref(['ric_msg']5, v1)
									case 'RiC-E06': ref(['ric_msg']6, v1)
									case 'RiC-E08': ref(['ric_msg']8, v1)
									case 'RiC-E10': ref(['ric_msg']10, v1)
									case 'RiC-E11': ref(['ric_msg']11, v1)
									case 'RiC-E12': ref(['ric_msg']12, v1)
									case 'RiC-E13': ref(['ric_msg']13, v1)
									case 'RiC-E14': ref(['ric_msg']14, v1)
									case 'RiC-E15': ref(['ric_msg']15, v1)
									case 'RiC-E16': ref(['ric_msg']16, v1)
									case 'RiC-E17': ref(['ric_msg']17, v1)
									case 'RiC-E18': ref(['ric_msg']18, v1)
									case 'RiC-E22': ref(['ric_msg']22, v1)
								endsel										
						,'</td>
                    </tr>
                    <tr>
                        <td style="font-weight: 600;">Identification Number</td>
                        <td>', v2, '</td>
                    </tr>'
            if p(v17) then       
			        '<tr>
                        <td style="font-weight: 600;">Kaywords</td>
                        <td>', v17+| - |, '</td>
                    </tr>'
                 fi   
                   ' <!-- Deuxième Section -->
                    <tr>
                        <td colspan="2" class="ric-section">
